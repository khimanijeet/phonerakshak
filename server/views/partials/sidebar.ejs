  <script>
    async function fetchGlobalUnread() {
      try {
        const res = await fetch('/admin/api/support/unread-count');
        if (!res.ok) return;
        const data = await res.json();
        const badge = document.getElementById('globalUnreadBadge');
        if (badge) {
          if (data.unreadCount > 0) {
            badge.innerText = data.unreadCount > 99 ? '99+' : data.unreadCount;
            badge.style.display = 'inline-block';
          } else {
            badge.style.display = 'none';
          }
        }
      } catch (err) {}
    }
    document.addEventListener('DOMContentLoaded', () => {
      fetchGlobalUnread();
      setInterval(fetchGlobalUnread, 15000);
    });
  </script>

