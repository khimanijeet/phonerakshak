<%- include('_layout-head', { title: 'PhoneRakshak - Reset Password' }) %>
<style>
  .auth-container { max-width: 400px; margin: 60px auto; padding: 32px; background: rgba(20, 25, 40, 0.4); border: 1px solid rgba(255,255,255,0.06); border-radius: 20px; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .auth-logo { text-align: center; margin-bottom: 24px; }
  .auth-logo svg { width: 48px; height: 48px; color: #8b5cf6; }
  .auth-title { font-size: 24px; font-weight: 700; color: #fff; text-align: center; margin-bottom: 8px; }
  .auth-sub { font-size: 14px; color: #94a3b8; text-align: center; margin-bottom: 32px; }
  .input-group { margin-bottom: 20px; }
  .input-label { display: block; font-size: 13px; font-weight: 600; color: #cbd5e1; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
  .input-field { width: 100%; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 12px 16px; border-radius: 12px; font-size: 16px; transition: border-color 0.2s; box-sizing: border-box; }
  .input-field:focus { outline: none; border-color: #8b5cf6; }
  .btn-primary { width: 100%; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; border: none; padding: 14px; border-radius: 12px; font-size: 16px; font-weight: 600; cursor: pointer; transition: opacity 0.2s; display: flex; justify-content: center; align-items: center; }
  .btn-primary:hover { opacity: 0.9; }
  .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
  .error-box { background: rgba(239, 68, 68, 0.1); color: #ef4444; padding: 12px; border-radius: 8px; font-size: 14px; margin-bottom: 20px; border: 1px solid rgba(239, 68, 68, 0.2); display: none; }
  .success-box { background: rgba(34, 197, 94, 0.1); color: #22c55e; padding: 12px; border-radius: 8px; font-size: 14px; margin-bottom: 20px; border: 1px solid rgba(34, 197, 94, 0.2); display: none; }
  
  /* OTP Input Style */
  .otp-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-bottom: 16px; }
  .otp-input { width: 100%; aspect-ratio: 1; text-align: center; font-size: 24px; font-weight: 700; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 8px; }
  .otp-input:focus { outline: none; border-color: #8b5cf6; }
  .resend-text { text-align: center; font-size: 13px; color: #94a3b8; margin-top: 16px; }
  .resend-text a { color: #8b5cf6; text-decoration: none; cursor: pointer; }
  .resend-text a.disabled { color: #475569; pointer-events: none; }
</style>

<body class="mobile-theme">
  <div class="mobile-container">
    <div class="auth-container">
      <div class="auth-logo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
      </div>
      <div class="auth-title">PhoneRakshak</div>
      <div class="auth-sub" id="auth-sub">Reset your password</div>

      <div id="error-box" class="error-box"></div>
      <div id="success-box" class="success-box"></div>

      <!-- Step 1: Phone Input -->
      <div id="step-phone">
        <div class="input-group">
          <label class="input-label">Registered Phone Number</label>
          <input type="tel" id="phone" class="input-field" placeholder="+91 9876543210" value="+91">
        </div>
        <button id="btn-send-otp" class="btn-primary">Send OTP</button>
      </div>

      <!-- Step 2: OTP Verification -->
      <div id="step-otp" style="display: none;">
        <label class="input-label" style="text-align: center; margin-bottom: 16px;">Enter 6-digit Code</label>
        <div class="otp-grid" id="otp-inputs">
          <input type="text" maxlength="1" class="otp-input" data-index="0">
          <input type="text" maxlength="1" class="otp-input" data-index="1">
          <input type="text" maxlength="1" class="otp-input" data-index="2">
          <input type="text" maxlength="1" class="otp-input" data-index="3">
          <input type="text" maxlength="1" class="otp-input" data-index="4">
          <input type="text" maxlength="1" class="otp-input" data-index="5">
        </div>
        <button id="btn-verify-otp" class="btn-primary">Verify OTP</button>
        <div class="resend-text">
          Resend code in <span id="timer">60</span>s <br/>
          <a id="btn-resend" class="disabled" style="display: inline-block; margin-top: 8px;">Resend OTP</a>
        </div>
      </div>

      <!-- Step 3: New Password Input -->
      <div id="step-password" style="display: none;">
        <div class="input-group">
          <label class="input-label">New Password</label>
          <input type="password" id="new-password" class="input-field" placeholder="At least 6 characters">
        </div>
        <div class="input-group">
          <label class="input-label">Confirm Password</label>
          <input type="password" id="confirm-password" class="input-field" placeholder="Re-enter password">
        </div>
        <button id="btn-reset-password" class="btn-primary">Save New Password</button>
      </div>

      <div style="text-align: center; margin-top: 24px;">
        <a href="/customer/login" style="font-size: 14px; color: #8b5cf6; text-decoration: none;">Back to Login</a>
      </div>

      <!-- Invisible Recaptcha Container -->
      <div id="recaptcha-container"></div>
    </div>
  </div>

  <!-- Firebase Web SDK (Compat) -->
  <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>

  <script>
    const firebaseConfig = <%- JSON.stringify(firebaseConfig || {}) %>;

    // Initialize Firebase
    if (!firebase.apps.length) {
      firebase.initializeApp(firebaseConfig);
    }

    const auth = firebase.auth();
    let confirmationResult = null;
    let timerInterval = null;
    let verifiedIdToken = null;

    // DOM Elements
    const stepPhone = document.getElementById('step-phone');
    const stepOtp = document.getElementById('step-otp');
    const stepPassword = document.getElementById('step-password');
    const phoneInput = document.getElementById('phone');
    const btnSendOtp = document.getElementById('btn-send-otp');
    const btnVerifyOtp = document.getElementById('btn-verify-otp');
    const btnResetPassword = document.getElementById('btn-reset-password');
    const btnResend = document.getElementById('btn-resend');
    const timerSpan = document.getElementById('timer');
    const errorBox = document.getElementById('error-box');
    const successBox = document.getElementById('success-box');
    const authSub = document.getElementById('auth-sub');
    const otpInputs = Array.from(document.querySelectorAll('.otp-input'));

    function showError(msg) {
      errorBox.innerText = msg;
      errorBox.style.display = 'block';
    }
    function hideError() {
      errorBox.style.display = 'none';
    }
    function showSuccess(msg) {
      successBox.innerText = msg;
      successBox.style.display = 'block';
    }

    // Set up reCAPTCHA verifier
    window.recaptchaVerifier = new firebase.auth.RecaptchaVerifier('recaptcha-container', {
      size: 'invisible'
    });

    function startTimer() {
      let timeLeft = 60;
      btnResend.classList.add('disabled');
      timerSpan.parentElement.style.display = 'block';
      timerInterval = setInterval(() => {
        timeLeft--;
        timerSpan.innerText = timeLeft;
        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          btnResend.classList.remove('disabled');
          timerSpan.parentElement.style.display = 'none';
          btnResend.style.display = 'inline-block';
        }
      }, 1000);
    }

    async function sendOtp() {
      hideError();
      const phone = phoneInput.value.trim();
      if (!phone || phone.length < 10) {
        return showError('Please enter a valid phone number with country code.');
      }

      btnSendOtp.disabled = true;
      btnSendOtp.innerText = 'Sending...';

      try {
        confirmationResult = await auth.signInWithPhoneNumber(phone, window.recaptchaVerifier);
        
        // Switch UI to Step 2
        stepPhone.style.display = 'none';
        stepOtp.style.display = 'block';
        authSub.innerText = `Code sent to ${phone.replace(/.(?=.{4})/g, '*')}`;
        startTimer();
        otpInputs[0].focus();
        
      } catch (error) {
        console.error(error);
        showError(error.message || 'Failed to send OTP.');
        window.recaptchaVerifier.render().then(function(widgetId) {
          grecaptcha.reset(widgetId);
        });
      } finally {
        btnSendOtp.disabled = false;
        btnSendOtp.innerText = 'Send OTP';
      }
    }

    // OTP Input logic (auto-focus next)
    otpInputs.forEach((input, index) => {
      input.addEventListener('keyup', (e) => {
        if (e.key >= 0 && e.key <= 9) {
          if (index < otpInputs.length - 1) otpInputs[index + 1].focus();
        } else if (e.key === 'Backspace') {
          if (index > 0 && !input.value) otpInputs[index - 1].focus();
        }
      });
      // Handle paste
      input.addEventListener('paste', (e) => {
        e.preventDefault();
        const pastedData = e.clipboardData.getData('text').replace(/\D/g, '').slice(0, 6);
        for(let i = 0; i < pastedData.length; i++) {
          if(otpInputs[i]) {
            otpInputs[i].value = pastedData[i];
            if(i < 5) otpInputs[i + 1].focus();
          }
        }
      });
    });

    async function verifyOtp() {
      hideError();
      const code = otpInputs.map(i => i.value).join('');
      if (code.length !== 6) {
        return showError('Please enter a valid 6-digit code.');
      }

      btnVerifyOtp.disabled = true;
      btnVerifyOtp.innerText = 'Verifying...';

      try {
        // Firebase Verify
        const result = await confirmationResult.confirm(code);
        const user = result.user;
        
        // Get Firebase ID Token
        verifiedIdToken = await user.getIdToken();

        // Switch UI to Step 3
        stepOtp.style.display = 'none';
        stepPassword.style.display = 'block';
        authSub.innerText = 'Create a new password';
        showSuccess('Identity verified. Please enter a new password.');
      } catch (error) {
        console.error(error);
        showError('Invalid code or expired.');
        otpInputs.forEach(i => i.value = '');
        otpInputs[0].focus();
      } finally {
        btnVerifyOtp.disabled = false;
        btnVerifyOtp.innerText = 'Verify OTP';
      }
    }

    async function resetPassword() {
      hideError();
      const newPassword = document.getElementById('new-password').value;
      const confirmPassword = document.getElementById('confirm-password').value;

      if (!newPassword || newPassword.length < 6) {
        return showError('Password must be at least 6 characters.');
      }
      if (newPassword !== confirmPassword) {
        return showError('Passwords do not match.');
      }

      btnResetPassword.disabled = true;
      btnResetPassword.innerText = 'Saving...';

      try {
        // Send to Backend
        const res = await fetch('/customer/reset-password-firebase', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ idToken: verifiedIdToken, newPassword })
        });
        const data = await res.json();
        
        if (data.success) {
          stepPassword.style.display = 'none';
          showSuccess('Password updated successfully! You can now log in.');
          setTimeout(() => {
            window.location.href = '/customer/login';
          }, 2000);
        } else {
          showError(data.error || 'Failed to update password.');
        }

      } catch (error) {
        console.error(error);
        showError('A network error occurred.');
      } finally {
        btnResetPassword.disabled = false;
        btnResetPassword.innerText = 'Save New Password';
      }
    }

    btnSendOtp.addEventListener('click', sendOtp);
    btnVerifyOtp.addEventListener('click', verifyOtp);
    btnResetPassword.addEventListener('click', resetPassword);
    btnResend.addEventListener('click', () => {
      if (!btnResend.classList.contains('disabled')) sendOtp();
    });

  </script>
</body>
</html>
