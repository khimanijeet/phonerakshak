<%- include('_layout-head', { title: 'Forgot Password — PhoneRakshak Customer' }) %>
<body>
<div class="login-shell">
  <div class="login-card">
    <div class="login-brand">
      <div class="brand-icon big">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div>
        <div class="brand-title big">PhoneRakshak</div>
        <div class="brand-sub">Reset your password</div>
      </div>
    </div>
    <% if (error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="alert success"><%= success %></div>
    <% } %>
    <form method="POST" action="/customer/forgot-password" class="login-form">
      <label>Phone number</label>
      <input name="phone" required autofocus value="<%= phone || '' %>" placeholder="+91 98xxxxxxxx" autocomplete="tel" />
      <button class="btn-primary" type="submit">Send Reset Link</button>
    </form>
    <p class="login-hint" style="margin-top: 1.5rem; text-align: center;">
      <a href="/customer/login" class="forgot-link">Back to Sign in</a>
    </p>
  </div>
</div>
</body>
</html>
