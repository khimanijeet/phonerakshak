<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_layout-head', { title: 'Support - PhoneRakshak' }) %>
  <style>
    .support-container {
      display: flex;
      flex-direction: column;
      height: calc(100vh - 120px);
      background: var(--surface);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      overflow: hidden;
      margin-bottom: 2rem;
    }
    .chat-header {
      padding: 1.5rem;
      border-bottom: 1px solid var(--border);
      background: var(--surface-hover);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .chat-header h2 {
      margin: 0;
      font-size: 1.25rem;
      color: var(--text-primary);
    }
    .support-status {
      font-size: 0.85rem;
      padding: 0.25rem 0.75rem;
      border-radius: 12px;
      background: rgba(16, 185, 129, 0.1);
      color: var(--success);
      border: 1px solid rgba(16, 185, 129, 0.2);
    }
    .support-status.escalated {
      background: rgba(245, 158, 11, 0.1);
      color: var(--warning);
      border-color: rgba(245, 158, 11, 0.2);
    }
    .chat-history {
      flex: 1;
      padding: 1.5rem;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .msg {
      max-width: 80%;
      padding: 1rem;
      border-radius: 1rem;
      line-height: 1.5;
      font-size: 0.95rem;
      word-wrap: break-word;
      position: relative;
    }
    .msg.bot {
      align-self: flex-start;
      background: var(--surface-hover);
      color: var(--text-primary);
      border-bottom-left-radius: 0.25rem;
    }
    .msg.user {
      align-self: flex-end;
      background: var(--primary);
      color: #fff;
      border-bottom-right-radius: 0.25rem;
    }
    .msg-time {
      display: block;
      font-size: 0.7rem;
      margin-top: 0.5rem;
      opacity: 0.7;
    }
    .quick-options {
      padding: 1rem 1.5rem;
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      background: var(--bg);
      border-top: 1px solid var(--border);
    }
    .quick-opt-btn {
      background: var(--surface);
      color: var(--text-secondary);
      border: 1px solid var(--border);
      padding: 0.5rem 1rem;
      border-radius: 20px;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.2s;
    }
    .quick-opt-btn:hover {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }
    .escalate-wrapper {
      padding: 0 1.5rem 1rem;
      background: var(--bg);
      text-align: center;
      display: none;
    }
    .escalate-btn {
      background: rgba(139, 92, 246, 0.1);
      color: #a78bfa;
      border: 1px solid rgba(139, 92, 246, 0.3);
      padding: 0.75rem 2rem;
      border-radius: var(--radius);
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      width: 100%;
      max-width: 300px;
    }
    .escalate-btn:hover {
      background: #8b5cf6;
      color: #fff;
    }
    .chat-input-area {
      padding: 1.5rem;
      background: var(--surface);
      border-top: 1px solid var(--border);
      display: flex;
      gap: 1rem;
    }
    .chat-input {
      flex: 1;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text-primary);
      padding: 0.75rem 1rem;
      border-radius: var(--radius);
      outline: none;
    }
    .chat-input:focus {
      border-color: var(--primary);
    }
    .chat-send-btn {
      background: var(--primary);
      color: #fff;
      border: none;
      padding: 0 1.5rem;
      border-radius: var(--radius);
      cursor: pointer;
      font-weight: 600;
      transition: background 0.2s;
    }
    .chat-send-btn:hover {
      background: var(--primary-hover);
    }
    .chat-send-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    @media (max-width: 768px) {
      .support-container {
        height: calc(100vh - 80px);
        margin-bottom: 0;
        border-radius: 0;
        border: none;
      }
    }
  </style>
</head>
<body class="dark-theme">
  <div class="layout-wrapper">
    <%- include('_sidebar', { active: 'support' }) %>
    <div class="main-content">
      <%- include('_topbar', { user: user }) %>
      
      <div class="content-body">
        <div class="support-container">
          <div class="chat-header">
            <h2>Support Chat</h2>
            <span class="support-status" id="ticketStatus">Bot Active</span>
          </div>
          
          <div class="chat-history" id="chatHistory">
            <!-- Messages will be injected here -->
          </div>
          
          <div class="escalate-wrapper" id="escalateWrapper">
            <button class="escalate-btn" onclick="escalateTicket()">👉 Talk to Human</button>
          </div>
          
          <div class="quick-options" id="quickOptions">
            <button class="quick-opt-btn" onclick="sendChat('Lost phone')">Lost phone</button>
            <button class="quick-opt-btn" onclick="sendChat('Lock device')">Lock device</button>
            <button class="quick-opt-btn" onclick="sendChat('Track location')">Track location</button>
            <button class="quick-opt-btn" onclick="sendChat('Alarm not working')">Alarm not working</button>
            <button class="quick-opt-btn" onclick="sendChat('SIM changed')">SIM changed</button>
            <button class="quick-opt-btn" onclick="sendChat('Other issue')">Other issue</button>
          </div>
          
          <div class="chat-input-area" id="inputArea">
            <input type="text" id="chatInput" class="chat-input" placeholder="Type your message..." onkeypress="handleEnter(event)">
            <button class="chat-send-btn" id="sendBtn" onclick="sendChat()">Send</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const chatHistory = document.getElementById('chatHistory');
    const chatInput = document.getElementById('chatInput');
    const sendBtn = document.getElementById('sendBtn');
    const escalateWrapper = document.getElementById('escalateWrapper');
    const quickOptions = document.getElementById('quickOptions');
    const ticketStatus = document.getElementById('ticketStatus');
    
    let isEscalated = false;

    function renderMessage(msg) {
      const div = document.createElement('div');
      div.className = 'msg ' + (msg.isBot ? 'bot' : 'user');
      
      const time = new Date(msg.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      
      div.innerHTML = `
        ${msg.text}
        <span class="msg-time">${time}</span>
      `;
      chatHistory.appendChild(div);
      chatHistory.scrollTop = chatHistory.scrollHeight;
    }

    function updateUIStatus(status, botCount) {
      if (status === 'escalated') {
        isEscalated = true;
        ticketStatus.textContent = 'Awaiting Human Agent';
        ticketStatus.className = 'support-status escalated';
        escalateWrapper.style.display = 'none';
        quickOptions.style.display = 'none';
      } else {
        if (botCount >= 1) {
          escalateWrapper.style.display = 'block';
        }
      }
    }

    async function loadHistory() {
      try {
        const res = await fetch('/api/support/history');
        const data = await res.json();
        
        if (data.messages && data.messages.length > 0) {
          data.messages.forEach(renderMessage);
          updateUIStatus(data.status, data.botResponseCount);
        } else {
          // Send initial greeting to backend if there's no history
          sendChat("Hello", true);
        }
      } catch (err) {
        console.error('Failed to load chat history', err);
      }
    }

    function handleEnter(e) {
      if (e.key === 'Enter') sendChat();
    }

    async function sendChat(textOverride, isInit = false) {
      const text = textOverride || chatInput.value.trim();
      if (!text) return;
      
      if (!textOverride && !isInit) {
        chatInput.value = '';
      }

      sendBtn.disabled = true;
      
      try {
        const res = await fetch('/api/support/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text })
        });
        const data = await res.json();
        
        chatHistory.innerHTML = '';
        if (data.messages) {
          data.messages.forEach(renderMessage);
        }
        updateUIStatus(data.status, data.botResponseCount);
      } catch (err) {
        console.error('Failed to send message', err);
      } finally {
        sendBtn.disabled = false;
        chatInput.focus();
      }
    }

    async function escalateTicket() {
      try {
        const res = await fetch('/api/support/escalate', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          // Refresh history to see the new bot message
          const histRes = await fetch('/api/support/history');
          const histData = await histRes.json();
          chatHistory.innerHTML = '';
          if (histData.messages) {
            histData.messages.forEach(renderMessage);
          }
          updateUIStatus(histData.status, histData.botResponseCount);
        }
      } catch (err) {
        console.error('Failed to escalate ticket', err);
      }
    }

    // Initialize
    loadHistory();
  </script>
</body>
</html>
