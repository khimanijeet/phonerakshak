<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_layout-head', { title: 'Support Chat - PhoneRakshak' }) %>
  <style>
    :root {
      --chat-bg-start: #0b1220;
      --chat-bg-end: #0a0f1c;
      --bubble-user-gradient: linear-gradient(135deg, #6366f1, #8b5cf6);
      --bubble-bot-bg: #121a2b;
      --glow-purple: rgba(139, 92, 246, 0.4);
      --glow-red: rgba(239, 68, 68, 0.4);
      --glow-green: rgba(16, 185, 129, 0.4);
      --msg-radius: 20px;
    }

    body.dark-theme {
      background: linear-gradient(180deg, var(--chat-bg-start), var(--chat-bg-end)) !important;
      font-family: 'Inter', 'Poppins', sans-serif;
      margin: 0;
      padding: 0;
    }

    .chat-wrapper {
      display: flex;
      flex-direction: column;
      height: 100vh; /* Mobile full height */
      max-width: 800px;
      margin: 0 auto;
      background: rgba(11, 18, 32, 0.8);
      backdrop-filter: blur(12px);
      position: relative;
    }

    /* HEADER */
    .chat-top-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1.5rem;
      background: rgba(18, 26, 43, 0.6);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      z-index: 10;
    }

    .chat-back-btn {
      color: var(--text-primary);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1rem;
      transition: color 0.2s;
    }
    .chat-back-btn:hover { color: #a78bfa; }

    .chat-header-info {
      text-align: center;
    }
    .chat-title {
      margin: 0;
      font-size: 1.1rem;
      font-weight: 600;
      color: #fff;
    }

    .status-indicator {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      font-size: 0.75rem;
      color: #9ca3af;
      margin-top: 0.2rem;
    }
    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }
    .status-dot.online { background: #10b981; box-shadow: 0 0 8px var(--glow-green); }
    .status-dot.offline { background: #6b7280; }

    .priority-badge {
      font-size: 0.7rem;
      padding: 0.3rem 0.6rem;
      background: rgba(139, 92, 246, 0.15);
      color: #c4b5fd;
      border: 1px solid rgba(139, 92, 246, 0.3);
      border-radius: 12px;
      box-shadow: 0 0 10px var(--glow-purple);
      display: flex;
      align-items: center;
      font-weight: 600;
      white-space: nowrap;
    }

    /* CHAT HISTORY */
    .chat-messages {
      flex: 1;
      padding: 1.5rem 1rem;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      scrollbar-width: none; /* Firefox */
    }
    .chat-messages::-webkit-scrollbar { display: none; } /* Chrome */

    .msg-group {
      display: flex;
      flex-direction: column;
      max-width: 85%;
      animation: fadeInSlide 0.3s ease-out forwards;
      opacity: 0;
      transform: translateY(10px);
    }
    @keyframes fadeInSlide {
      to { opacity: 1; transform: translateY(0); }
    }

    .msg-group.bot { align-self: flex-start; }
    .msg-group.user { align-self: flex-end; align-items: flex-end; }

    .msg-bubble {
      padding: 0.85rem 1.25rem;
      font-size: 0.95rem;
      line-height: 1.4;
      word-wrap: break-word;
      position: relative;
    }

    .msg-group.user .msg-bubble {
      background: var(--bubble-user-gradient);
      color: #fff;
      border-radius: var(--msg-radius) var(--msg-radius) 4px var(--msg-radius);
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.2);
    }

    .msg-group.bot .msg-bubble {
      background: var(--bubble-bot-bg);
      color: #e5e7eb;
      border-radius: var(--msg-radius) var(--msg-radius) var(--msg-radius) 4px;
      border: 1px solid rgba(255, 255, 255, 0.05);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }
    
    .premium-glow .msg-group.bot .msg-bubble {
      border: 1px solid rgba(139, 92, 246, 0.3);
      box-shadow: 0 0 10px rgba(139, 92, 246, 0.1) inset, 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    .msg-time {
      font-size: 0.65rem;
      color: #6b7280;
      margin-top: 0.3rem;
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }

    .msg-status-icon {
      font-size: 0.6rem;
      color: #8b5cf6;
    }

    /* TYPING INDICATOR */
    .typing-indicator {
      display: none;
      align-items: center;
      gap: 4px;
      padding: 1rem 1.25rem;
      background: var(--bubble-bot-bg);
      border-radius: var(--msg-radius);
      border: 1px solid rgba(255, 255, 255, 0.05);
      width: fit-content;
      align-self: flex-start;
      margin-bottom: 1rem;
    }
    .typing-dot {
      width: 6px;
      height: 6px;
      background: #9ca3af;
      border-radius: 50%;
      animation: typing 1.4s infinite ease-in-out;
    }
    .typing-dot:nth-child(1) { animation-delay: 0s; }
    .typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .typing-dot:nth-child(3) { animation-delay: 0.4s; }
    @keyframes typing {
      0%, 100% { transform: scale(1); opacity: 0.4; }
      50% { transform: scale(1.2); opacity: 1; background: #c4b5fd; }
    }

    /* LOADER */
    .chat-loader {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 2rem;
      color: #9ca3af;
      font-size: 0.9rem;
    }
    .chat-loader svg {
      animation: spin 1s linear infinite;
      margin-right: 0.5rem;
    }
    @keyframes spin { 100% { transform: rotate(360deg); } }

    /* ERROR RETRY */
    .retry-btn {
      background: none;
      border: none;
      color: #ef4444;
      font-size: 0.7rem;
      cursor: pointer;
      text-decoration: underline;
      padding: 0;
      margin-left: 0.5rem;
    }

    /* QUICK ACTIONS */
    .quick-actions {
      display: flex;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      overflow-x: auto;
      scrollbar-width: none;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      background: rgba(18, 26, 43, 0.4);
    }
    .quick-actions::-webkit-scrollbar { display: none; }
    
    .quick-btn {
      white-space: nowrap;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #e5e7eb;
      padding: 0.5rem 1rem;
      border-radius: 20px;
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .quick-btn:hover {
      background: rgba(255, 255, 255, 0.1);
      transform: translateY(-1px);
    }
    .quick-btn.urgent {
      border-color: rgba(239, 68, 68, 0.3);
      color: #fca5a5;
    }
    .quick-btn.urgent:hover {
      background: rgba(239, 68, 68, 0.1);
      box-shadow: 0 0 10px var(--glow-red);
    }

    /* INPUT AREA */
    .chat-input-wrapper {
      padding: 1rem;
      background: rgba(18, 26, 43, 0.8);
      backdrop-filter: blur(20px);
      display: flex;
      align-items: center;
      gap: 0.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .chat-input-box {
      flex: 1;
      background: rgba(0, 0, 0, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 24px;
      padding: 0.85rem 1.25rem;
      color: #fff;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .chat-input-box:focus {
      border-color: rgba(139, 92, 246, 0.5);
      box-shadow: 0 0 10px rgba(139, 92, 246, 0.2);
    }
    .chat-input-box::placeholder { color: #6b7280; }

    .chat-send-btn {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--bubble-user-gradient);
      border: none;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 4px 10px var(--glow-purple);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .chat-send-btn:hover {
      transform: scale(1.05);
      box-shadow: 0 6px 15px var(--glow-purple);
    }
    .chat-send-btn:disabled {
      background: #4b5563;
      box-shadow: none;
      cursor: not-allowed;
      transform: none;
    }

    .icon-btn {
      background: none;
      border: none;
      color: #9ca3af;
      cursor: pointer;
      padding: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.2s;
    }
    .icon-btn:hover { color: #fff; }

  </style>
</head>
<body class="dark-theme <%= ctx.isPremium ? 'premium-glow' : '' %>">
  
  <div class="chat-wrapper">
    <!-- Header -->
    <header class="chat-top-header">
      <div style="flex: 1;">
        <a href="/customer" class="chat-back-btn">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </a>
      </div>
      
      <div class="chat-header-info">
        <h1 class="chat-title">Support Chat</h1>
        <div class="status-indicator">
          <div class="status-dot online"></div>
          <span>Online</span>
        </div>
      </div>
      
      <div style="flex: 1; display: flex; justify-content: flex-end;">
        <% if (ctx.isPremium) { %>
          <div class="priority-badge">⚡ Priority</div>
        <% } %>
      </div>
    </header>

    <!-- Chat Messages Area -->
    <main class="chat-messages" id="chatArea">
      <div id="historyLoader" class="chat-loader">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        Loading messages...
      </div>
      <!-- Messages injected here -->
      <div class="typing-indicator" id="typingIndicator">
        <div class="typing-dot"></div>
        <div class="typing-dot"></div>
        <div class="typing-dot"></div>
      </div>
    </main>

    <!-- Quick Actions -->
    <div class="quick-actions" id="quickActions">
      <% if (ctx.isPremium) { %>
        <button class="quick-btn urgent" onclick="prefill('URGENT: Report Lost Phone')">🔴 Report Lost Phone</button>
      <% } %>
      <button class="quick-btn" onclick="prefill('Technical Issue')">⚠️ Technical Issue</button>
      <button class="quick-btn" onclick="prefill('General Help')">💬 General Help</button>
    </div>

    <!-- Input Area -->
    <footer class="chat-input-wrapper">
      <button class="icon-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
      </button>
      
      <input type="text" id="msgInput" class="chat-input-box" placeholder="Type your message..." autocomplete="off">
      
      <button id="sendBtn" class="chat-send-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
      </button>
    </footer>
  </div>

  <script>
    const chatArea = document.getElementById('chatArea');
    const msgInput = document.getElementById('msgInput');
    const sendBtn = document.getElementById('sendBtn');
    const typingIndicator = document.getElementById('typingIndicator');
    
    function prefill(text) {
      msgInput.value = text;
      msgInput.focus();
    }

    function formatTime(ts) {
      return new Date(ts).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    function scrollToBottom() {
      chatArea.scrollTop = chatArea.scrollHeight;
    }

    function createMessageElement(text, isBot, timestamp, isOptimistic = false) {
      const group = document.createElement('div');
      group.className = `msg-group ${isBot ? 'bot' : 'user'}`;
      
      const timeStr = formatTime(timestamp);
      
      let ticks = '';
      if (!isBot) {
        if (isOptimistic) {
          ticks = '<span class="msg-status-icon status-indicator-txt" style="color:#9ca3af;">✔</span>';
        } else {
          ticks = '<span class="msg-status-icon status-indicator-txt">✔✔</span>';
        }
      }
      
      group.innerHTML = `
        <div class="msg-bubble">${text}</div>
        <div class="msg-time">
          ${timeStr} ${ticks}
        </div>
      `;
      return group;
    }

    async function loadHistory() {
      const loader = document.getElementById('historyLoader');
      try {
        const res = await fetch('/api/support/history');
        if (!res.ok) throw new Error('Failed to load');
        const data = await res.json();
        
        loader.style.display = 'none';
        
        if (data.ticket && data.ticket.messages && data.ticket.messages.length > 0) {
          data.ticket.messages.forEach(m => {
            const el = createMessageElement(m.text, m.isBot, m.timestamp);
            chatArea.insertBefore(el, typingIndicator);
          });
          scrollToBottom();
        } else {
          // Welcome message if new
          const welcome = createMessageElement("Hello! How can PhoneRakshak support assist you today?", true, Date.now());
          chatArea.insertBefore(welcome, typingIndicator);
          scrollToBottom();
        }
      } catch (err) {
        console.error(err);
        loader.innerHTML = '<span style="color: #ef4444">Failed to load chat history. Please refresh.</span>';
      }
    }

    async function sendMessage(retryText = null, retryGroupEl = null) {
      const text = retryText || msgInput.value.trim();
      if (!text) return;

      let userEl = retryGroupEl;
      if (!userEl) {
        // Render user message immediately (optimistic)
        userEl = createMessageElement(text, false, Date.now(), true);
        chatArea.insertBefore(userEl, typingIndicator);
        msgInput.value = '';
        scrollToBottom();
      } else {
        // Clear retry state if retrying
        const statusEl = userEl.querySelector('.status-indicator-txt');
        if(statusEl) statusEl.innerHTML = '<span style="color:#9ca3af;">✔</span>';
      }

      sendBtn.disabled = true;

      // Show typing indicator
      typingIndicator.style.display = 'flex';
      scrollToBottom();

      try {
        const res = await fetch('/api/support/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text })
        });
        
        if (!res.ok) throw new Error('Failed to send');
        
        const data = await res.json();
        
        // Hide typing indicator
        typingIndicator.style.display = 'none';
        
        if (data.ticket && data.ticket.messages) {
           const msgs = data.ticket.messages;
           
           // Replace optimistic user message with confirmed one
           if (msgs.length >= 2) {
             const userMsg = msgs[msgs.length - 2];
             if (!userMsg.isBot && userMsg.text === text) {
               const confirmedUserEl = createMessageElement(userMsg.text, false, userMsg.timestamp, false);
               chatArea.replaceChild(confirmedUserEl, userEl);
               userEl = confirmedUserEl; // update reference for error handling edge cases
             }
           }

           const lastMsg = msgs[msgs.length - 1];
           if (lastMsg && lastMsg.isBot) {
             const botEl = createMessageElement(lastMsg.text, true, lastMsg.timestamp);
             chatArea.insertBefore(botEl, typingIndicator);
             scrollToBottom();
           }
        }
      } catch (err) {
        console.error(err);
        typingIndicator.style.display = 'none';
        
        // Update user message to show failed state
        const timeEl = userEl.querySelector('.msg-time');
        if (timeEl) {
          timeEl.innerHTML = `<span style="color: #ef4444;">Failed to send</span> <button class="retry-btn">Retry</button>`;
          timeEl.querySelector('.retry-btn').onclick = () => sendMessage(text, userEl);
        }
      } finally {
        sendBtn.disabled = false;
        if(!retryText) msgInput.focus();
      }
    }

    msgInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') sendMessage();
    });
    
    sendBtn.addEventListener('click', sendMessage);

    // Init
    loadHistory();
  </script>
</body>
</html>
