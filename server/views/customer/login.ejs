<%- include('_layout-head', { title: 'Sign in — PhoneRakshak Customer' }) %>
<style>
  .otp-group { display: none; margin-top: 15px; }
  .otp-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-bottom: 16px; }
  .otp-input { width: 100%; aspect-ratio: 1; text-align: center; font-size: 20px; font-weight: 700; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 8px; }
  .otp-input:focus { outline: none; border-color: #8b5cf6; }
</style>
<body>
<div class="login-shell">
  <div class="login-card">
    <div class="login-brand">
      <div class="brand-icon big">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div>
        <div class="brand-title big">PhoneRakshak</div>
        <div class="brand-sub">Secure Login via OTP</div>
      </div>
    </div>
    
    <% if (error) { %>
      <div class="alert error" id="server-error"><%= error %></div>
    <% } %>
    <div class="alert error" id="js-error" style="display: none;"></div>

    <div id="step-phone">
      <label>Phone number</label>
      <input type="tel" id="phone" required autofocus value="<%= phone || '+91' %>" placeholder="+91 98xxxxxxxx" autocomplete="tel" />
      <button class="btn-primary" id="btn-send-otp" type="button" style="margin-top:15px;">Send OTP</button>
    </div>

    <div id="step-otp" class="otp-group">
      <label style="text-align: center; margin-bottom: 10px; display: block;">Enter 6-digit Code</label>
      <div class="otp-grid" id="otp-inputs">
        <input type="text" maxlength="1" class="otp-input" data-index="0">
        <input type="text" maxlength="1" class="otp-input" data-index="1">
        <input type="text" maxlength="1" class="otp-input" data-index="2">
        <input type="text" maxlength="1" class="otp-input" data-index="3">
        <input type="text" maxlength="1" class="otp-input" data-index="4">
        <input type="text" maxlength="1" class="otp-input" data-index="5">
      </div>
      <button class="btn-primary" id="btn-verify-otp" type="button">Verify & Sign In</button>
    </div>

    <form method="POST" action="/customer/login" id="backend-form" style="display:none;">
      <input type="hidden" name="idToken" id="idToken" />
    </form>

    <div id="recaptcha-container"></div>

    <p class="login-hint" style="margin-top:20px;">
      New here? <a href="/customer/register" class="forgot-link">Create an account</a>
    </p>
  </div>
</div>

<script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>

<script>
  const firebaseConfig = <%- JSON.stringify(typeof firebaseConfig !== 'undefined' ? firebaseConfig : {}) %>;
  if (!firebase.apps.length) {
    firebase.initializeApp(firebaseConfig);
  }
  const auth = firebase.auth();
  let confirmationResult = null;

  const stepPhone = document.getElementById('step-phone');
  const stepOtp = document.getElementById('step-otp');
  const btnSendOtp = document.getElementById('btn-send-otp');
  const btnVerifyOtp = document.getElementById('btn-verify-otp');
  const phoneInput = document.getElementById('phone');
  const errorBox = document.getElementById('js-error');
  const serverError = document.getElementById('server-error');
  const otpInputs = Array.from(document.querySelectorAll('.otp-input'));

  function showError(msg) {
    if (serverError) serverError.style.display = 'none';
    errorBox.innerText = msg;
    errorBox.style.display = 'block';
  }

  window.recaptchaVerifier = new firebase.auth.RecaptchaVerifier('recaptcha-container', { size: 'invisible' });

  btnSendOtp.addEventListener('click', async () => {
    errorBox.style.display = 'none';
    const phone = phoneInput.value.trim();
    if (!phone || phone.length < 10) return showError('Please enter a valid phone number with country code.');
    
    btnSendOtp.disabled = true;
    btnSendOtp.innerText = 'Sending...';

    try {
      confirmationResult = await auth.signInWithPhoneNumber(phone, window.recaptchaVerifier);
      stepPhone.style.display = 'none';
      stepOtp.style.display = 'block';
      otpInputs[0].focus();
    } catch (error) {
      console.error(error);
      showError(error.message || 'Failed to send OTP.');
      window.recaptchaVerifier.render().then(wId => grecaptcha.reset(wId));
    } finally {
      btnSendOtp.disabled = false;
      btnSendOtp.innerText = 'Send OTP';
    }
  });

  // OTP Input logic
  otpInputs.forEach((input, index) => {
    input.addEventListener('keyup', (e) => {
      if (e.key >= 0 && e.key <= 9 && index < otpInputs.length - 1) otpInputs[index + 1].focus();
      else if (e.key === 'Backspace' && index > 0 && !input.value) otpInputs[index - 1].focus();
    });
    input.addEventListener('paste', (e) => {
      e.preventDefault();
      const pastedData = e.clipboardData.getData('text').replace(/\D/g, '').slice(0, 6);
      for(let i = 0; i < pastedData.length; i++) {
        if(otpInputs[i]) { otpInputs[i].value = pastedData[i]; if(i < 5) otpInputs[i + 1].focus(); }
      }
    });
  });

  btnVerifyOtp.addEventListener('click', async () => {
    errorBox.style.display = 'none';
    const code = otpInputs.map(i => i.value).join('');
    if (code.length !== 6) return showError('Please enter a valid 6-digit code.');

    btnVerifyOtp.disabled = true;
    btnVerifyOtp.innerText = 'Verifying...';

    try {
      const result = await confirmationResult.confirm(code);
      const idToken = await result.user.getIdToken();
      
      document.getElementById('idToken').value = idToken;
      document.getElementById('backend-form').submit();
    } catch (error) {
      console.error(error);
      showError('Invalid code or expired.');
      otpInputs.forEach(i => i.value = '');
      otpInputs[0].focus();
    } finally {
      btnVerifyOtp.disabled = false;
      btnVerifyOtp.innerText = 'Verify & Sign In';
    }
  });
</script>
</body></html>
