<% 
  const plan = customer && customer.plan ? customer.plan : 'free';
  const planName = plan.charAt(0).toUpperCase() + plan.slice(1);
%>
<%- include('_layout-head', { title: 'Account - PhoneRakshak' }) %>
<style>
.account-header { text-align: center; margin: 24px 0; }
.avatar-circle { width: 80px; height: 80px; background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 32px; font-weight: 600; color: #fff; box-shadow: 0 8px 16px rgba(99, 102, 241, 0.4); }
.user-name { font-size: 20px; font-weight: 600; color: #fff; margin-bottom: 4px; }
.user-phone { font-size: 14px; color: #94a3b8; }
.settings-group { background: rgba(20, 25, 40, 0.4); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; overflow: hidden; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); margin-bottom: 24px; }
.settings-item { display: flex; justify-content: space-between; align-items: center; padding: 16px; border-bottom: 1px solid rgba(255,255,255,0.05); }
.settings-item:last-child { border-bottom: none; }
.settings-label { font-size: 15px; color: #fff; font-weight: 500; }
.settings-sub { font-size: 13px; color: #94a3b8; margin-top: 4px; }
.btn-primary-small { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; border: none; padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; cursor: pointer; transition: opacity 0.2s; }
.btn-primary-small:hover { opacity: 0.9; }
</style>
<body class="mobile-theme">
  <div class="mobile-container">
    
    <header class="mobile-header">
      <div class="header-brand">
        <div class="brand-shield">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div class="header-text-group">
          <div class="brand-name">
            Account
          </div>
          <div class="brand-tagline">Profile & Plan</div>
        </div>
      </div>
    </header>

    <main class="mobile-content">

      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <% if (notice) { %><div class="alert success"><%= notice %></div><% } %>

      <div class="account-header">
        <div class="avatar-circle">
          <%= customer && customer.name ? customer.name.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div class="user-name"><%= customer && customer.name || 'User' %></div>
        <div class="user-phone"><%= customer && customer.phone || user.phone %></div>
      </div>

      <div class="settings-group">
        <div class="settings-item">
          <div style="width: 100%;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
              <div class="settings-label">Update Profile</div>
            </div>
            <form method="POST" action="/customer/account/profile" style="display: flex; flex-direction: column; gap: 12px;">
              <input type="text" name="name" value="<%= customer && customer.name || '' %>" placeholder="Your Name" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 10px 12px; border-radius: 8px; font-size: 14px;" />
              <button class="btn-primary-small" type="submit" style="align-self: flex-start;">Save Profile</button>
            </form>
          </div>
        </div>
      </div>

      <div class="settings-group">
        <div class="settings-item">
          <div style="width: 100%;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
              <div class="settings-label">Subscription</div>
              <% if (plan !== 'free') { %>
                <span class="pf-status text-green" style="background: rgba(34,197,94,0.15); padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;"><%= planName.toUpperCase() %> ACTIVE</span>
              <% } else { %>
                <span class="pf-status text-red" style="background: rgba(239,68,68,0.15); padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;">FREE PLAN</span>
              <% } %>
            </div>
            
            <% if (plan !== 'free') { %>
              <div class="settings-sub" style="margin-bottom: 12px;">Your <%= planName %> plan is active and auto-renews.</div>
              <a href="/customer/pricing" class="btn-primary-small" style="text-decoration:none; display:inline-block; background: transparent; border: 1px solid #6366f1; color: #818cf8;">Manage Plan</a>
            <% } else { %>
              <div class="settings-sub" style="margin-bottom: 12px;">Upgrade to Premium for advanced protection features and priority support.</div>
              <a href="/customer/pricing" class="btn-primary-small" style="text-decoration:none; display:inline-block; width: 100%; text-align: center; padding: 10px; box-sizing: border-box;">Upgrade Now</a>
            <% } %>
          </div>
        </div>
      </div>

      <div class="settings-group">
        <div class="settings-item">
          <div>
            <div class="settings-label">Support</div>
            <div class="settings-sub">Get help with your device</div>
          </div>
          <button class="btn-primary-small" style="background: rgba(255,255,255,0.1); color: #fff;">Contact Us</button>
        </div>
        <div class="settings-item">
          <div>
            <div class="settings-label">FAQs</div>
            <div class="settings-sub">Frequently asked questions</div>
          </div>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #94a3b8;"><polyline points="9 18 15 12 9 6"/></svg>
        </div>
      </div>

    </main>

    <nav class="mobile-nav">
      <a href="/customer" class="nav-item">
        <div class="nav-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg></div>
        <span>Home</span>
      </a>
      <a href="/customer/security" class="nav-item">
        <div class="nav-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></div>
        <span>Security</span>
      </a>
      <a href="/customer/activity" class="nav-item">
        <div class="nav-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
        <span>Activity</span>
      </a>
      <a href="/customer/settings" class="nav-item">
        <div class="nav-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></div>
        <span>Settings</span>
      </a>
      <a href="/customer/account" class="nav-item active">
        <div class="nav-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
        <span>Account</span>
      </a>
    </nav>
  </div>
</body>
</html>
