<% const leaflet = false; const chartjs = false; %>
<%- include('../partials/header', { title: 'Support Dashboard — PhoneRakshak Admin', leaflet }) %>
<style>
  .support-dashboard {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 120px);
    gap: 1rem;
    overflow: hidden;
  }
  
  .stats-row {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }
  
  .stat-card {
    flex: 1;
    background: rgba(18, 26, 43, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .stat-card .label { font-size: 0.8rem; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px; }
  .stat-card .value { font-size: 1.5rem; font-weight: 600; color: #fff; margin-top: 0.25rem; }

  .support-container {
    display: flex;
    flex: 1;
    gap: 1rem;
    overflow: hidden;
  }
  
  /* Ticket List */
  .ticket-list-panel {
    width: 350px;
    background: rgba(18, 26, 43, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  
  .ticket-filters {
    padding: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .ticket-filters select, .ticket-filters input {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #fff;
    padding: 0.5rem;
    border-radius: 6px;
    outline: none;
    font-size: 0.85rem;
  }
  
  .tickets {
    flex: 1;
    overflow-y: auto;
  }
  .tickets::-webkit-scrollbar { width: 4px; }
  .tickets::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }
  
  .ticket-item {
    padding: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    cursor: pointer;
    transition: background 0.2s;
    position: relative;
  }
  .ticket-item:hover { background: rgba(255, 255, 255, 0.05); }
  .ticket-item.active { background: rgba(139, 92, 246, 0.1); border-left: 3px solid #8b5cf6; }
  
  .ticket-item .phone { font-weight: 600; color: #fff; font-size: 0.95rem; }
  .ticket-item .preview { color: #9ca3af; font-size: 0.8rem; margin-top: 0.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 90%; }
  .ticket-item .time { position: absolute; right: 1rem; top: 1rem; font-size: 0.7rem; color: #6b7280; }
  
  .badge { display: inline-block; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; margin-right: 0.3rem; }
  .badge.urgent { background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); }
  .badge.high { background: rgba(249, 115, 22, 0.2); color: #f97316; border: 1px solid rgba(249, 115, 22, 0.3); }
  .badge.normal { background: rgba(59, 130, 246, 0.2); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.3); }
  .badge.low { background: rgba(107, 114, 128, 0.2); color: #9ca3af; border: 1px solid rgba(107, 114, 128, 0.3); }
  
  .badge.status-open { background: rgba(16, 185, 129, 0.1); color: #10b981; }
  .badge.status-in_progress { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
  .badge.status-resolved { background: rgba(139, 92, 246, 0.1); color: #8b5cf6; }
  .badge.status-closed { background: rgba(107, 114, 128, 0.1); color: #9ca3af; }
  
  .unread-dot {
    position: absolute;
    right: 1rem;
    top: 2.5rem;
    width: 8px;
    height: 8px;
    background: #ef4444;
    border-radius: 50%;
    box-shadow: 0 0 5px #ef4444;
  }
  
  /* Chat Panel */
  .chat-panel {
    flex: 1;
    background: rgba(18, 26, 43, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  
  .chat-header {
    padding: 1rem;
    background: rgba(0, 0, 0, 0.2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .chat-header .title { font-weight: 600; color: #fff; font-size: 1.1rem; }
  .chat-header .subtitle { font-size: 0.8rem; color: #9ca3af; margin-top: 0.2rem; }
  
  .chat-actions { display: flex; gap: 0.5rem; align-items: center; }
  .chat-actions select { background: rgba(0,0,0,0.3); color: #fff; border: 1px solid rgba(255,255,255,0.1); padding: 0.4rem; border-radius: 4px; }
  .btn-action { padding: 0.4rem 0.8rem; border: none; border-radius: 4px; font-size: 0.8rem; cursor: pointer; font-weight: 500; transition: 0.2s; }
  .btn-action.resolve { background: rgba(16, 185, 129, 0.2); color: #10b981; }
  .btn-action.resolve:hover { background: rgba(16, 185, 129, 0.3); }
  .btn-action.close { background: rgba(107, 114, 128, 0.2); color: #9ca3af; }
  .btn-action.close:hover { background: rgba(107, 114, 128, 0.3); }
  
  .chat-messages {
    flex: 1;
    padding: 1.5rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .msg-group {
    display: flex;
    flex-direction: column;
    max-width: 75%;
  }
  .msg-group.user { align-self: flex-start; }
  .msg-group.admin { align-self: flex-end; align-items: flex-end; }
  .msg-group.bot { align-self: flex-end; align-items: flex-end; }
  
  .msg-bubble {
    padding: 0.75rem 1rem;
    border-radius: 12px;
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .msg-group.user .msg-bubble { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #e5e7eb; border-bottom-left-radius: 2px; }
  .msg-group.admin .msg-bubble { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; border-bottom-right-radius: 2px; box-shadow: 0 4px 10px rgba(139, 92, 246, 0.2); }
  .msg-group.bot .msg-bubble { background: linear-gradient(135deg, #10b981, #059669); color: #fff; border-bottom-right-radius: 2px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.2); }
  
  .msg-time { font-size: 0.65rem; color: #6b7280; margin-top: 0.3rem; }
  
  .chat-input {
    padding: 1rem;
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    gap: 0.5rem;
  }
  .chat-input input {
    flex: 1;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.75rem 1rem;
    border-radius: 24px;
    color: #fff;
    outline: none;
  }
  .chat-input input:focus { border-color: rgba(139, 92, 246, 0.5); }
  .chat-input button {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .chat-input button:disabled { background: #4b5563; cursor: not-allowed; }
  
  .empty-state {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #6b7280;
  }
  .empty-state svg { width: 48px; height: 48px; margin-bottom: 1rem; opacity: 0.5; }
</style>

<div class="app-shell">
  <%- include('../partials/sidebar', { active: 'support' }) %>
  <main class="app-main">
    <%- include('../partials/topbar', { pageTitle: 'Support Tickets' }) %>
    
    <div class="content support-dashboard">
      
      <!-- Stats Row -->
      <div class="stats-row">
        <div class="stat-card">
          <div class="label">Total Tickets</div>
          <div class="value" id="stat-total">-</div>
        </div>
        <div class="stat-card">
          <div class="label">Open Tickets</div>
          <div class="value" id="stat-open">-</div>
        </div>
        <div class="stat-card">
          <div class="label" style="color: #ef4444;">Urgent</div>
          <div class="value" id="stat-urgent">-</div>
        </div>
        <div class="stat-card">
          <div class="label">Avg Response</div>
          <div class="value" id="stat-avg">-</div>
        </div>
      </div>
      
      <!-- Main Container -->
      <div class="support-container">
        
        <!-- Left Panel: Ticket List -->
        <div class="ticket-list-panel">
          <div class="ticket-filters">
            <input type="text" id="searchFilter" placeholder="Search phone or ID...">
            <div style="display: flex; gap: 0.5rem;">
              <select id="statusFilter" style="flex:1;">
                <option value="all">All Status</option>
                <option value="bot_active">Bot Active</option>
                <option value="human_assigned">Human Assigned</option>
                <option value="open">Open</option>
                <option value="in_progress">In Progress</option>
                <option value="resolved">Resolved</option>
                <option value="closed">Closed</option>
              </select>
              <select id="priorityFilter" style="flex:1;">
                <option value="all">All Priority</option>
                <option value="urgent">Urgent</option>
                <option value="high">High</option>
                <option value="normal">Normal</option>
                <option value="low">Low</option>
              </select>
            </div>
          </div>
          
          <div class="tickets" id="ticketList">
            <div class="empty-state" style="padding: 2rem;">Loading tickets...</div>
          </div>
        </div>
        
        <!-- Right Panel: Chat -->
        <div class="chat-panel" id="chatPanel" style="display: none;">
          <div class="chat-header">
            <div>
              <div class="title" id="chatTitle">Customer Phone</div>
              <div class="subtitle" id="chatSubtitle">Ticket ID</div>
            </div>
            <div class="chat-actions">
              <select id="chatStatusSelect">
                <option value="bot_active">Bot Active</option>
                <option value="human_assigned">Human Assigned</option>
                <option value="open">Open</option>
                <option value="in_progress">In Progress</option>
                <option value="resolved">Resolved</option>
                <option value="closed">Closed</option>
              </select>
              <button class="btn-action resolve" onclick="updateStatus('resolved')">Mark Resolved</button>
              <button class="btn-action close" onclick="updateStatus('closed')">Close</button>
            </div>
          </div>
          
          <div class="chat-messages" id="chatMessages"></div>
          
          <div class="chat-input">
            <input type="text" id="adminMsgInput" placeholder="Type a reply..." autocomplete="off">
            <button id="adminSendBtn" onclick="sendAdminMessage()">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
            </button>
          </div>
        </div>
        
        <!-- Right Panel: Empty State -->
        <div class="chat-panel" id="emptyChatPanel">
          <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Select a ticket to view conversation
          </div>
        </div>
        
      </div>
    </div>
  </main>
</div>

<script>
  let tickets = [];
  let currentTicketId = null;
  let pollingInterval = null;

  async function fetchTickets() {
    try {
      const res = await fetch('/admin/api/support/tickets');
      if (!res.ok) throw new Error('Failed to fetch tickets');
      const data = await res.json();
      tickets = data.tickets || [];
      
      document.getElementById('stat-total').innerText = data.stats ? data.stats.total : '-';
      document.getElementById('stat-open').innerText = data.stats ? data.stats.open : '-';
      document.getElementById('stat-urgent').innerText = data.stats ? data.stats.urgent : '-';
      document.getElementById('stat-avg').innerText = data.stats ? data.stats.avgResponse : '-';
      
      renderTicketList();
    } catch (err) {
      console.error("Failed to load tickets", err);
      const list = document.getElementById('ticketList');
      if (list) list.innerHTML = '<div class="empty-state" style="padding: 2rem; color: #ef4444;">Error loading tickets. Retrying...</div>';
    }
  }

  function renderTicketList() {
    const list = document.getElementById('ticketList');
    const search = document.getElementById('searchFilter').value.toLowerCase();
    const status = document.getElementById('statusFilter').value;
    const priority = document.getElementById('priorityFilter').value;
    
    let filtered = tickets.filter(t => {
      const matchSearch = String(t.phone || '').toLowerCase().includes(search) || String(t.ticketId || '').toLowerCase().includes(search);
      const matchStatus = status === 'all' || t.status === status;
      const matchPriority = priority === 'all' || t.priority === priority;
      return matchSearch && matchStatus && matchPriority;
    });
    
    if (filtered.length === 0) {
      list.innerHTML = '<div class="empty-state" style="padding: 2rem;">No support tickets found.</div>';
      return;
    }
    
    list.innerHTML = filtered.map(t => {
      let timeAgo = "Just now";
      if (t.updatedAt) {
        const mins = Math.floor((new Date() - new Date(t.updatedAt)) / 60000);
        if (mins < 60) timeAgo = `${mins} mins ago`;
        else timeAgo = `${Math.floor(mins/60)} hours ago`;
      }
      
      const urgentIcon = t.priority === 'urgent' ? '🔥 ' : '';
      const preview = t.lastMessage ? (t.lastMessage.length > 50 ? t.lastMessage.substring(0, 47) + '...' : t.lastMessage) : 'No messages yet';
      
      let statusIcon = '';
      let statusClass = 'status-' + t.status;
      let statusText = t.status.replace('_', ' ');
      
      if (t.status === 'bot_active') {
        statusIcon = '🤖 ';
        statusClass = 'status-in_progress';
      } else if (t.status === 'human_assigned') {
        statusIcon = '👨‍💻 ';
        statusClass = 'status-open';
      }
      
      return \`
        <div class="ticket-item \${t.ticketId === currentTicketId ? 'active' : ''}" onclick="openChat('\${t.ticketId}', '\${t.phone}')">
          <div style="margin-bottom: 0.3rem;">
            <span class="badge \${t.priority}">\${urgentIcon}\${t.priority}</span>
            <span class="badge \${statusClass}">\${statusIcon}\${statusText}</span>
          </div>
          <div class="phone">\${t.phone}</div>
          <div class="preview">\${preview}</div>
          <div class="time">\${timeAgo}</div>
          \${t.unread ? '<div class="unread-dot"></div>' : ''}
        </div>
      \`;
    }).join('');
  }

  async function openChat(ticketId, phone) {
    currentTicketId = ticketId;
    renderTicketList(); // update active state
    
    document.getElementById('emptyChatPanel').style.display = 'none';
    document.getElementById('chatPanel').style.display = 'flex';
    
    document.getElementById('chatTitle').innerText = phone;
    document.getElementById('chatSubtitle').innerText = 'ID: ' + ticketId;
    
    const t = tickets.find(x => x.ticketId === ticketId);
    if (t) document.getElementById('chatStatusSelect').value = t.status;
    
    await fetchChatHistory();
    
    // Clear and reset polling for active chat
    if (pollingInterval) clearInterval(pollingInterval);
    pollingInterval = setInterval(async () => {
      await fetchTickets(); // refresh list quietly
      if (currentTicketId) await fetchChatHistory(true);
    }, 3000);
  }

  function scrollToBottom() {
    const box = document.getElementById('chatMessages');
    box.scrollTop = box.scrollHeight;
  }

  async function fetchChatHistory(quiet = false) {
    if (!currentTicketId) return;
    try {
      const res = await fetch(\`/admin/api/support/history?ticketId=\${currentTicketId}\`);
      const data = await res.json();
      
      const box = document.getElementById('chatMessages');
      if (!data.ticket || !data.ticket.messages) {
        box.innerHTML = '<div class="empty-state">No messages</div>';
        return;
      }
      
      const isAtBottom = box.scrollHeight - box.scrollTop <= box.clientHeight + 50;
      
      box.innerHTML = data.ticket.messages.map(m => {
        const cls = m.sender || 'user'; // admin, bot, user
        const timeStr = new Date(m.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        
        let senderLabel = '👤 User';
        if (m.sender === 'bot') senderLabel = '🤖 AI Assistant';
        else if (m.sender === 'admin') senderLabel = '👨‍💻 Support Agent';
        
        return \`
          <div class="msg-group \${cls}">
            <div class="msg-bubble">\${m.text}</div>
            <div class="msg-time">\${senderLabel} • \${timeStr}</div>
          </div>
        \`;
      }).join('');
      
      if (!quiet || isAtBottom) scrollToBottom();
      
    } catch (err) {
      console.error(err);
    }
  }

  async function sendAdminMessage() {
    if (!currentTicketId) return;
    const input = document.getElementById('adminMsgInput');
    const btn = document.getElementById('adminSendBtn');
    const text = input.value.trim();
    if (!text) return;
    
    btn.disabled = true;
    input.disabled = true;
    
    try {
      await fetch('/admin/api/support/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ticketId: currentTicketId, message: text })
      });
      input.value = '';
      await fetchChatHistory();
      await fetchTickets(); // updates list preview and removes unread badge
    } catch (err) {
      console.error(err);
      alert('Failed to send message');
    } finally {
      btn.disabled = false;
      input.disabled = false;
      input.focus();
    }
  }

  async function updateStatus(newStatus) {
    if (!currentTicketId) return;
    if (!newStatus) newStatus = document.getElementById('chatStatusSelect').value;
    else document.getElementById('chatStatusSelect').value = newStatus;
    
    try {
      await fetch(\`/admin/api/support/ticket/\${currentTicketId}/status\`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus })
      });
      await fetchTickets();
    } catch (err) {
      console.error(err);
    }
  }

  // Event Listeners
  document.getElementById('searchFilter').addEventListener('input', renderTicketList);
  document.getElementById('statusFilter').addEventListener('change', renderTicketList);
  document.getElementById('priorityFilter').addEventListener('change', renderTicketList);
  document.getElementById('chatStatusSelect').addEventListener('change', () => updateStatus());
  
  document.getElementById('adminMsgInput').addEventListener('keypress', (e) => {
    if (e.key === 'Enter') sendAdminMessage();
  });

  // Init
  fetchTickets();
  // Poll overall tickets every 10s if not active
  setInterval(() => {
    if (!currentTicketId) fetchTickets();
  }, 10000);
</script>
<%- include('../partials/footer') %>
