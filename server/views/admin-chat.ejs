<% const leaflet = false; const chartjs = false; %>
<%- include('partials/header', { title: 'Ticket ' + ticket._id + ' — Admin', leaflet }) %>

<style>
  .chat-layout {
    display: flex;
    gap: 20px;
    height: calc(100vh - 100px); /* Fill remaining space below topbar */
    padding-bottom: 20px;
  }
  .chat-sidebar {
    width: 300px;
    background: var(--surface-bg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .chat-main {
    flex: 1;
    background: var(--surface-bg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .chat-messages {
    flex: 1;
    padding: 20px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .chat-input-area {
    padding: 15px;
    background: rgba(0,0,0,0.1);
    border-top: 1px solid var(--border-color);
    display: flex;
    gap: 10px;
  }
  .chat-input {
    flex: 1;
    background: var(--bg-color);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 10px 15px;
    border-radius: 20px;
    outline: none;
  }
  .chat-input:focus {
    border-color: var(--accent-purple);
  }
  .btn-send {
    background: var(--accent-purple);
    color: #fff;
    border: none;
    padding: 10px 20px;
    border-radius: 20px;
    cursor: pointer;
    font-weight: 600;
  }
  .btn-send:hover { opacity: 0.9; }

  /* Message Bubbles */
  .msg-group {
    display: flex;
    flex-direction: column;
    max-width: 80%;
  }
  .msg-group.user { align-self: flex-start; }
  .msg-group.bot { align-self: flex-start; }
  .msg-group.admin { align-self: flex-end; align-items: flex-end; }

  .msg-bubble {
    padding: 10px 15px;
    border-radius: 12px;
    line-height: 1.4;
    word-wrap: break-word;
  }
  .msg-group.user .msg-bubble { background: rgba(255,255,255,0.05); color: #fff; border: 1px solid rgba(255,255,255,0.1); }
  .msg-group.bot .msg-bubble { background: rgba(59, 130, 246, 0.1); color: #93c5fd; border: 1px solid rgba(59, 130, 246, 0.3); }
  .msg-group.admin .msg-bubble { background: var(--accent-purple); color: #fff; }

  .msg-meta { font-size: 0.7rem; color: var(--text-muted); margin-top: 5px; margin-bottom: 2px; }
  
  /* Status actions */
  .status-actions select {
    width: 100%;
    padding: 8px;
    background: var(--bg-color);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    border-radius: 6px;
  }

  .typing-indicator {
    display: none;
    font-size: 0.8rem;
    color: var(--text-muted);
    padding: 10px 20px;
    font-style: italic;
  }
</style>

<div class="app-shell">
  <%- include('partials/sidebar', { active: 'support' }) %>
  <main class="app-main">
    <%- include('partials/topbar', { pageTitle: 'Support Ticket' }) %>
    <div class="content">
      
      <div class="chat-layout">
        <!-- Sidebar Info -->
        <aside class="chat-sidebar">
          <h3>Ticket Info</h3>
          <div>
            <div class="msg-meta">Customer Phone</div>
            <div class="mono" style="font-size: 1.1rem;"><%= ticket.phone %></div>
          </div>
          <div>
            <div class="msg-meta">Customer Name</div>
            <div><%= customer ? customer.name : 'Unknown' %></div>
          </div>
          <div>
            <div class="msg-meta">Subscription Plan</div>
            <div>
              <% if (customer) { %>
                <span class="badge badge-<%= customer.plan %>">
                  <%= customer.plan.toUpperCase() %>
                </span>
              <% } else { %>
                <span class="status status-inactive">Unknown</span>
              <% } %>
            </div>
          </div>
          <div>
            <div class="msg-meta">Priority</div>
            <span class="pill pill-grey" style="text-transform: capitalize;"><%= ticket.priority %></span>
          </div>
          <div>
            <div class="msg-meta">Issue Type</div>
            <span class="pill pill-grey" style="text-transform: capitalize;"><%= ticket.issueType %></span>
          </div>
          <hr style="border:0; border-top: 1px solid var(--border-color); margin: 10px 0;">
          <div>
            <div class="msg-meta">Update Status</div>
            <div class="status-actions">
              <select id="statusSelect">
                <option value="bot_active" <%= ticket.status === 'bot_active' ? 'selected' : '' %>>Bot Active</option>
                <option value="human_assigned" <%= ticket.status === 'human_assigned' ? 'selected' : '' %>>Human Assigned</option>
                <option value="in_progress" <%= ticket.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                <option value="resolved" <%= ticket.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
                <option value="closed" <%= ticket.status === 'closed' ? 'selected' : '' %>>Closed</option>
              </select>
            </div>
          </div>
        </aside>

        <!-- Main Chat -->
        <section class="chat-main">
          <div class="chat-messages" id="chatArea">
            <% ticket.messages.forEach(msg => { %>
              <div class="msg-group <%= msg.sender === 'user' ? 'user' : (msg.sender === 'bot' || msg.isBot ? 'bot' : 'admin') %>">
                <div class="msg-meta">
                  <%= msg.sender === 'user' ? 'Customer' : (msg.sender === 'bot' || msg.isBot ? 'AI Bot' : 'Support Agent') %> • 
                  <%= new Date(msg.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                </div>
                <div class="msg-bubble"><%= msg.text %></div>
              </div>
            <% }) %>
            <div id="typingIndicator" class="typing-indicator">Customer is typing...</div>
          </div>

          <div class="chat-input-area">
            <input type="text" id="msgInput" class="chat-input" placeholder="Type a reply to the customer..." autocomplete="off">
            <button id="sendBtn" class="btn-send">Send Reply</button>
          </div>
        </section>

      </div>
    </div>
  </main>
</div>

<%- include('partials/footer') %>

<script src="/socket.io/socket.io.js"></script>
<script>
  const ticketId = "<%= ticket._id %>";
  const chatArea = document.getElementById('chatArea');
  const msgInput = document.getElementById('msgInput');
  const sendBtn = document.getElementById('sendBtn');
  const statusSelect = document.getElementById('statusSelect');
  const typingIndicator = document.getElementById('typingIndicator');

  // Socket.io
  const socket = io();
  socket.emit('join_ticket', ticketId);

  let typingTimeout = null;

  function scrollToBottom() {
    chatArea.scrollTop = chatArea.scrollHeight;
  }
  scrollToBottom(); // initial scroll

  socket.on('new_message', (data) => {
    if (data.ticket && data.ticket.messages) {
      // Just grab the latest message
      const msg = data.ticket.messages[data.ticket.messages.length - 1];
      
      // If it's an admin message, we likely already optimistically appended it.
      // But if another admin sent it, we should append it.
      // For simplicity, we can just reload the DOM or safely append.
      // We will only append if it's NOT an admin message (since we optimistically append our own)
      if (msg.sender !== 'admin') {
        appendMessage(msg);
      }
    }
  });

  socket.on('typing', (data) => {
    if (data.userType === 'user') {
      typingIndicator.style.display = 'block';
      scrollToBottom();
    }
  });

  socket.on('stop_typing', (data) => {
    if (data.userType === 'user') {
      typingIndicator.style.display = 'none';
    }
  });

  function appendMessage(msg) {
    typingIndicator.style.display = 'none';
    const group = document.createElement('div');
    group.className = `msg-group ${msg.sender === 'user' ? 'user' : (msg.sender === 'bot' || msg.isBot ? 'bot' : 'admin')}`;
    
    let senderName = 'Customer';
    if (msg.sender === 'admin') senderName = 'Support Agent';
    if (msg.sender === 'bot' || msg.isBot) senderName = 'AI Bot';

    const time = new Date(msg.timestamp || Date.now()).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});

    group.innerHTML = `
      <div class="msg-meta">${senderName} • ${time}</div>
      <div class="msg-bubble">${msg.text}</div>
    `;
    
    chatArea.insertBefore(group, typingIndicator);
    scrollToBottom();
  }

  async function sendMessage() {
    const text = msgInput.value.trim();
    if (!text) return;

    // Optimistic UI
    appendMessage({ text, sender: 'admin', timestamp: Date.now() });
    msgInput.value = '';
    sendBtn.disabled = true;

    try {
      const res = await fetch(`/admin/ticket/${ticketId}/reply`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text })
      });
      if (!res.ok) throw new Error('Failed to send');
      
      // Update status to in_progress if we just replied
      statusSelect.value = 'in_progress';
      
    } catch (err) {
      console.error(err);
      alert('Failed to send message.');
    } finally {
      sendBtn.disabled = false;
      msgInput.focus();
    }
  }

  msgInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      socket.emit('stop_typing', { ticketId, userType: 'admin' });
      sendMessage();
    }
  });

  msgInput.addEventListener('input', () => {
    socket.emit('typing', { ticketId, userType: 'admin' });
    clearTimeout(typingTimeout);
    typingTimeout = setTimeout(() => {
      socket.emit('stop_typing', { ticketId, userType: 'admin' });
    }, 1500);
  });

  sendBtn.addEventListener('click', sendMessage);

  // Status Change
  statusSelect.addEventListener('change', async (e) => {
    const newStatus = e.target.value;
    try {
      const res = await fetch(`/admin/ticket/${ticketId}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus })
      });
      if (!res.ok) throw new Error('Failed to update status');
      // optional: add a system message to the chat UI
    } catch (err) {
      console.error(err);
      alert('Failed to update ticket status.');
    }
  });

</script>
