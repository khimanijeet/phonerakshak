<% const leaflet = false; const chartjs = true; const active = 'dashboard'; %>
<%- include('partials/header', { title: 'PhoneRakshak Admin Panel', leaflet }) %>
<div class="app-shell">
  <%- include('partials/sidebar', { active }) %>
  <main class="app-main">
    <%- include('partials/topbar', { pageTitle: 'Dashboard', subtitle: "Welcome back, Admin! Here's what's happening." }) %>

    <div class="content admin-dashboard">

      <!-- Top Stats Row -->
      <div class="stat-grid-4">
        <div class="glass-card stat-card-new">
          <div class="stat-header">
            <div class="stat-label">Total Users</div>
            <div class="stat-icon-new icon-purple-glow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
          </div>
          <div class="stat-value-new"><%= customers && customers.length ? customers.length : (stats ? stats.totalUsers : 0) %></div>
          <div class="stat-trend trend-up">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
            2.1% <span class="muted">this week</span>
          </div>
        </div>

        <div class="glass-card stat-card-new">
          <div class="stat-header">
            <div class="stat-label">Active Devices</div>
            <div class="stat-icon-new icon-blue-glow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
            </div>
          </div>
          <div class="stat-value-new"><%= stats ? stats.activeUsers : 0 %></div>
          <div class="stat-trend trend-up">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
            4.2% <span class="muted">this week</span>
          </div>
        </div>

        <div class="glass-card stat-card-new">
          <div class="stat-header">
            <div class="stat-label">Security Alerts</div>
            <div class="stat-icon-new icon-red-glow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            </div>
          </div>
          <% const recentAlertsCount = alerts ? alerts.filter(a => (Date.now() - a.timestamp) < 86400000).length : 0; %>
          <div class="stat-value-new" id="metric-alerts"><%= recentAlertsCount %></div>
          <div class="stat-trend trend-down">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
            1.5% <span class="muted">this week</span>
          </div>
        </div>

        <div class="glass-card stat-card-new">
          <div class="stat-header">
            <div class="stat-label">Commands Executed</div>
            <div class="stat-icon-new icon-green-glow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </div>
          </div>
          <div class="stat-value-new" id="metric-commands"><%= commands ? commands.length : 0 %></div>
          <div class="stat-trend trend-up">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
            3.8% <span class="muted">this week</span>
          </div>
        </div>
      </div>

      <!-- Charts Row -->
      <div class="dashboard-grid-2">
        <div class="glass-card chart-card-new">
          <div class="card-header-new">
            <h2>Security Overview</h2>
            <div class="dropdown-filter">Last 7 Days <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></div>
          </div>
          <div class="chart-legend-row">
            <div class="chart-legend-item"><span class="legend-dot dot-red"></span> Threats Detected</div>
            <div class="chart-legend-item"><span class="legend-dot dot-purple"></span> Blocked Attempts</div>
          </div>
          <div class="chart-container-large">
            <canvas id="securityOverviewChart"></canvas>
          </div>
        </div>

        <div class="glass-card chart-card-new">
          <div class="card-header-new">
            <h2>Top Attack Types</h2>
            <div class="dropdown-filter">Last 7 Days <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></div>
          </div>
          <div class="doughnut-layout">
            <div class="doughnut-container">
              <canvas id="topAttackTypesChart"></canvas>
              <div class="doughnut-center-text">
                <div class="big">46</div>
                <div class="small">Total</div>
              </div>
            </div>
            <div class="doughnut-legend">
              <div class="d-legend-item">
                <div><span class="legend-dot dot-red"></span> Brute Force</div>
                <div class="d-legend-val">65%</div>
              </div>
              <div class="d-legend-item">
                <div><span class="legend-dot dot-purple"></span> Failed Logins</div>
                <div class="d-legend-val">20%</div>
              </div>
              <div class="d-legend-item">
                <div><span class="legend-dot dot-blue"></span> DDoS Attacks</div>
                <div class="d-legend-val">10%</div>
              </div>
              <div class="d-legend-item">
                <div><span class="legend-dot dot-orange"></span> API Spam</div>
                <div class="d-legend-val">5%</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tables Row -->
      <div class="dashboard-grid-2">
        <div class="glass-card table-card-new">
          <div class="card-header-new">
            <h2>Recent Security Alerts</h2>
            <a href="/admin/alerts" class="view-all-link">View All</a>
          </div>
          <div class="table-responsive">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>TIME</th>
                  <th>TYPE</th>
                  <th>DETAILS</th>
                  <th>DEVICE / USER</th>
                </tr>
              </thead>
              <tbody id="recent-alerts-tbody">
                <% if (alerts && alerts.length > 0) { %>
                  <% alerts.slice(0, 5).forEach(a => { 
                       const isThreat = ['brute_force', 'failed_login', 'ddos', 'sos', 'emergency', 'wrong_pin'].includes(a.type);
                       const colorClass = isThreat ? 'text-red' : 'text-blue';
                       let deviceLabel = a.deviceId ? 'Device: ' + a.deviceId.slice(0,8) : 'System';
                  %>
                    <tr>
                      <td class="muted"><%= new Date(a.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></td>
                      <td class="<%= colorClass %>"><%= a.type.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) %></td>
                      <td><%= a.message %></td>
                      <td><%= deviceLabel %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr><td colspan="4" class="muted text-center" style="padding: 20px;">No alerts found.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="glass-card table-card-new">
          <div class="card-header-new">
            <h2>Commands Overview</h2>
            <a href="/admin/commands" class="view-all-link">View All</a>
          </div>
          <div class="table-responsive">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>COMMAND</th>
                  <th>EXECUTED</th>
                  <th>SUCCESS</th>
                </tr>
              </thead>
              <tbody id="commands-overview-tbody">
                <% 
                  const cmdStats = {};
                  if (commands) {
                    commands.forEach(c => {
                      if (!cmdStats[c.type]) cmdStats[c.type] = { total: 0, success: 0 };
                      cmdStats[c.type].total++;
                      if (c.status === 'done') cmdStats[c.type].success++;
                    });
                  }
                  const cmdRows = Object.keys(cmdStats).map(k => ({
                    name: k,
                    total: cmdStats[k].total,
                    pct: Math.round((cmdStats[k].success / cmdStats[k].total) * 100)
                  })).sort((a,b) => b.total - a.total).slice(0, 5);
                %>
                <% if (cmdRows.length > 0) { %>
                  <% cmdRows.forEach(cr => { 
                       const color = cr.pct >= 90 ? 'text-green' : (cr.pct >= 70 ? 'text-orange' : 'text-red');
                  %>
                    <tr>
                      <td><%= cr.name %></td>
                      <td><%= cr.total %></td>
                      <td class="<%= color %>"><%= cr.pct %>%</td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr><td colspan="3" class="muted text-center" style="padding: 20px;">No commands executed.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Bottom Stats Row -->
      <div class="dashboard-grid-3">
        <div class="glass-card mini-chart-card">
          <div class="card-header-new">
            <h2>Device Status</h2>
            <a href="/admin/devices" class="view-all-link">View All</a>
          </div>
          <% 
            const dOnline = stats ? stats.activeUsers : 0;
            const dTotal = stats ? stats.devicesRegistered : 0;
            const dOffline = dTotal - dOnline;
            const pctOnline = dTotal ? Math.round((dOnline/dTotal)*100) : 0;
            const pctOffline = dTotal ? Math.round((dOffline/dTotal)*100) : 0;
          %>
          <div class="mini-doughnut-layout">
            <div class="doughnut-container-small">
              <canvas id="deviceStatusChart" data-online="<%= dOnline %>" data-offline="<%= dOffline %>"></canvas>
              <div class="doughnut-center-text">
                <div class="big"><%= dTotal %></div>
                <div class="small">Total</div>
              </div>
            </div>
            <div class="mini-legend">
              <div class="m-legend-item">
                <div><span class="legend-dot dot-green"></span> Online</div>
                <div class="muted"><%= dOnline %> (<%= pctOnline %>%)</div>
              </div>
              <div class="m-legend-item">
                <div><span class="legend-dot dot-red"></span> Offline</div>
                <div class="muted"><%= dOffline %> (<%= pctOffline %>%)</div>
              </div>
              <div class="m-legend-item">
                <div><span class="legend-dot dot-grey"></span> Inactive</div>
                <div class="muted">0 (0%)</div>
              </div>
            </div>
          </div>
        </div>

        <div class="glass-card mini-chart-card">
          <div class="card-header-new">
            <h2>Platform Distribution</h2>
            <a href="/admin/devices" class="view-all-link">View All</a>
          </div>
          <%
            let android = 0, ios = 0, web = 0;
            if (devices) {
              devices.forEach(d => {
                const m = (d.deviceModel || '').toLowerCase();
                if (m.includes('iphone') || m.includes('ipad')) ios++;
                else if (m.includes('web') || m.includes('browser')) web++;
                else android++;
              });
            }
            const pTotal = android + ios + web || 1;
            const pAndroid = Math.round((android/pTotal)*100);
            const pIos = Math.round((ios/pTotal)*100);
            const pWeb = Math.round((web/pTotal)*100);
          %>
          <div class="progress-bars-container">
            <div class="p-bar-row">
              <div class="p-bar-label">Android</div>
              <div class="p-bar-track"><div class="p-bar-fill bg-green" style="width: <%= pAndroid %>%"></div></div>
              <div class="p-bar-val"><%= pAndroid %>%</div>
            </div>
            <div class="p-bar-row">
              <div class="p-bar-label">iOS</div>
              <div class="p-bar-track"><div class="p-bar-fill bg-purple" style="width: <%= pIos %>%"></div></div>
              <div class="p-bar-val"><%= pIos %>%</div>
            </div>
            <div class="p-bar-row">
              <div class="p-bar-label">Web</div>
              <div class="p-bar-track"><div class="p-bar-fill bg-blue" style="width: <%= pWeb %>%"></div></div>
              <div class="p-bar-val"><%= pWeb %>%</div>
            </div>
          </div>
        </div>

        <div class="glass-card mini-chart-card">
          <div class="card-header-new">
            <h2>Subscription Status</h2>
            <a href="/admin/subscriptions" class="view-all-link">View All</a>
          </div>
          <%
            let sActive = 0, sExpired = 0, sPending = 0;
            if (customers && customers.length > 0) {
              customers.forEach(c => {
                if (c.isPremium) sActive++;
                else sExpired++;
              });
            } else {
              // Fallback
              sActive = 1048; sExpired = 150; sPending = 50;
            }
            const sTotal = sActive + sExpired + sPending || 1;
            const pctActive = Math.round((sActive/sTotal)*100);
            const pctExpired = Math.round((sExpired/sTotal)*100);
            const pctPending = Math.round((sPending/sTotal)*100);
          %>
          <div class="mini-doughnut-layout">
            <div class="doughnut-container-small">
              <canvas id="subscriptionStatusChart" data-active="<%= sActive %>" data-expired="<%= sExpired %>" data-pending="<%= sPending %>"></canvas>
              <div class="doughnut-center-text">
                <div class="big"><%= sTotal %></div>
                <div class="small">Total</div>
              </div>
            </div>
            <div class="mini-legend">
              <div class="m-legend-item">
                <div><span class="legend-dot dot-green"></span> Active</div>
                <div class="muted"><%= sActive %> (<%= pctActive %>%)</div>
              </div>
              <div class="m-legend-item">
                <div><span class="legend-dot dot-red"></span> Expired</div>
                <div class="muted"><%= sExpired %> (<%= pctExpired %>%)</div>
              </div>
              <div class="m-legend-item">
                <div><span class="legend-dot dot-orange"></span> Pending</div>
                <div class="muted"><%= sPending %> (<%= pctPending %>%)</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <footer class="dash-footer">© <%= (new Date()).getFullYear() %> PhoneRakshak Admin Panel. All rights reserved.</footer>
    </div>
  </main>

</div>

<!-- Custom dashboard charts -->
<script>
  window.SERVER_DATA = {
    labels: <%- dailySeries ? JSON.stringify(dailySeries.labels.slice(-7).map(d => d.slice(5))) : "[]" %>,
    threats: <%- dailySeries ? JSON.stringify(dailySeries.sos.slice(-7)) : "[]" %>,
    blocked: <%- dailySeries ? JSON.stringify(dailySeries.reports.slice(-7)) : "[]" %>,
    attackTypes: {
      bruteForce: 45,
      failedLogins: 20,
      ddos: 15,
      apiSpam: 20
    }
  };
</script>
<script src="/js/dashboard-charts.js"></script>

<script>
// Real-time updates polling
setInterval(async () => {
  try {
    const res = await fetch('/admin/api/poll');
    const data = await res.json();
    
    // Update metric cards directly
    const recentAlertsCount = data.alerts.filter(a => (Date.now() - a.timestamp) < 86400000).length;
    const alertEl = document.getElementById('metric-alerts');
    if (alertEl && parseInt(alertEl.innerText) !== recentAlertsCount) {
      alertEl.innerText = recentAlertsCount;
      alertEl.parentElement.style.animation = 'pulseGlow 1s';
      setTimeout(() => alertEl.parentElement.style.animation = '', 1000);
    }

    const cmdEl = document.getElementById('metric-commands');
    if (cmdEl && parseInt(cmdEl.innerText) !== data.commands.length) {
      cmdEl.innerText = data.commands.length;
      cmdEl.parentElement.style.animation = 'pulseGlow 1s';
      setTimeout(() => cmdEl.parentElement.style.animation = '', 1000);
    }
    
    // The tables and charts would be fully redrawn here in a reactive framework (React/Vue).
    // For pure Vanilla JS we could manually manipulate the DOM, but typically a full refresh is safer
    // or we only update the top metrics seamlessly as done above.
  } catch (err) {
    console.error('Polling error', err);
  }
}, 15000);
</script>

<%- include('partials/footer', { leaflet: false, chartjs: true }) %>
